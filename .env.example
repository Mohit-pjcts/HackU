# Copy to .env (never commit .env). Names only, no values.
# Server-side only: none of these are ever sent to the browser.

ANTHROPIC_API_KEY=
# Exact model ID from platform.claude.com/docs/en/models/overview (default: claude-sonnet-5-5)
MODEL_NAME=
# Optional: comma-separated extra models the test page may request, for the bake-off
# e.g. claude-sonnet-5-5,claude-opus-5-5
ALLOWED_MODELS=
# Optional: adaptive-thinking effort (low | medium | high | xhigh | max). Default low = faster pointing.
MODEL_EFFORT=
# Optional: set to 1 to run with a fake model (no key, no cost) while building the front end
MOCK_MODEL=

# Guard rails for the public demo link
MAX_CALLS_PER_SESSION=
RATE_LIMIT_PER_MINUTE=
GLOBAL_CALLS_PER_HOUR=
# If set, every request must send header x-access-code with this value
JUDGE_ACCESS_CODE=
# Below this self-reported confidence (0-1) the buddy says "I can't tell" instead of pointing. Default 0.5
CONFIDENCE_FLOOR=
